# Copy to .env (same folder as README.md). Real environment variables override this file.
# Changes are picked up on the next validation run; no restart needed.

# Document Extraction Agent mode:
#   deterministic  = no LLM call; rule-based parser, token figures are estimates (default, offline-safe)
#   llm            = call the LLM gateway (APEX / Copilot, OpenAI-compatible /chat/completions)
ACH_LLM_MODE=deterministic

# Needed only when ACH_LLM_MODE=llm
ACH_LLM_BASE_URL=https://apex.example.internal/v1
ACH_LLM_MODEL=gpt-4o
APEX_API_KEY=
# ACH_LLM_CA_BUNDLE=C:\path\to\corporate-ca.pem
